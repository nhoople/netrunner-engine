{
  "name": "netrunner-engine",
  "version": "1.147.255",
  "private": true,
  "license": "MIT",
  "description": "Hand-authored Netrunner rules engine library. Pins CR data to v26.03 and cards-data to v1.147.23.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "netrunner-engine": "./dist/cli.js"
  },
  "scripts": {
    "fetch-cr": "node scripts/fetch-cr-data.mjs",
    "fetch-cards": "node scripts/fetch-cards-data.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:jnet": "vitest run --config vitest.jnet.config.ts",
    "test:watch": "vitest",
    "playouts": "tsx scripts/playouts.ts",
    "playouts:nightly": "tsx scripts/playouts.ts --seeds 200",
    "cli": "tsx src/cli.ts",
    "cli:help": "tsx src/cli.ts --help",
    "demo": "tsx src/cli.ts --demo",
    "demo:library": "tsx src/cli.ts --library",
    "demo:ice-break": "tsx src/cli.ts --ice-break",
    "demo:ice-etr": "tsx src/cli.ts --ice-etr",
    "demo:pump-break": "tsx src/cli.ts --pump-break",
    "demo:multi-sub-etr": "tsx src/cli.ts --multi-sub-etr",
    "demo:fortify-pump": "tsx src/cli.ts --fortify-pump",
    "demo:tithe": "tsx src/cli.ts --tithe",
    "demo:rototurret": "tsx src/cli.ts --rototurret",
    "prepare-data": "npm run fetch-cr && npm run fetch-cards",
    "kind-reference": "node scripts/build-kind-reference.mjs --write",
    "mutate:hosting-trash": "stryker run stryker/hosting-trash.config.mjs",
    "mutate:uninstall": "stryker run stryker/uninstall.config.mjs",
    "mutate:swap": "stryker run stryker/swap.config.mjs",
    "mutate:visibility": "stryker run stryker/visibility.config.mjs",
    "mutate:corp-install": "stryker run stryker/corp-install.config.mjs",
    "mutate:runner-install": "stryker run stryker/runner-install.config.mjs",
    "mutate:rez": "stryker run stryker/rez.config.mjs",
    "mutate:access": "stryker run stryker/access.config.mjs",
    "mutate:damage": "stryker run stryker/damage.config.mjs",
    "mutate:card-flags": "stryker run stryker/card-flags.config.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
