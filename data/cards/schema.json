{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nhoople/netrunner-engine/data/cards/schema.json",
  "title": "NetrunnerEngineCard",
  "description": "Card definition as pure data. Effect IR is the executable language; unknown IR nodes fail closed at load time.",
  "type": "object",
  "required": ["id", "title", "type", "side"],
  "additionalProperties": false,
  "$defs": {
    "startsRunSpec": {
      "type": "object",
      "required": ["servers"],
      "properties": {
        "servers": {
          "type": "string",
          "enum": ["any", "central", "hq_rd", "rd", "hq"]
        },
        "requireNotRunThisTurn": { "type": "boolean" },
        "bonusAccessFromVirus": { "type": "boolean" },
        "bonusAccess": { "type": "integer", "minimum": 0 },
        "iceRezCostIncrease": { "type": "integer", "minimum": 0 },
        "placeEventCredits": { "type": "integer", "minimum": 0 },
        "onSuccessfulRun": { "type": "object" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "identity",
        "agenda",
        "asset",
        "upgrade",
        "ice",
        "operation",
        "event",
        "hardware",
        "program",
        "resource"
      ]
    },
    "side": { "type": "string", "enum": ["corp", "runner"] },
    "installCost": { "type": "integer", "minimum": 0 },
    "rezCost": { "type": "integer", "minimum": 0 },
    "playCost": { "type": "integer", "minimum": 0 },
    "trashCost": { "type": "integer", "minimum": 0 },
    "strength": { "type": "integer" },
    "subtypes": { "type": "array", "items": { "type": "string" } },
    "agendaPoints": { "type": "integer", "minimum": 0 },
    "advancementRequirement": { "type": "integer", "minimum": 0 },
    "recurringCreditsMax": { "type": "integer", "minimum": 0 },
    "link": { "type": "integer", "minimum": 0 },
    "subroutines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "effect"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "effect": { "type": "object" }
        }
      }
    },
    "breaker": {
      "type": "object",
      "required": ["breaksSubtype", "strength", "breakCredits"],
      "properties": {
        "breaksSubtype": {
          "type": "string",
          "description": "Ice subtype to break, or \"*\" for AI."
        },
        "strength": { "type": "integer" },
        "breakCredits": { "type": "integer", "minimum": 0 },
        "breakMaxSubs": {
          "type": "integer",
          "minimum": 1,
          "description": "Max subroutines per paid break ability use (default 1)."
        },
        "pumpCredits": { "type": "integer", "minimum": 0 },
        "pumpStrength": { "type": "integer" },
        "pumpUsesIcebreakerCount": { "type": "boolean" },
        "breakCreditsDiscountIfSuccessfulRunThisTurn": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "paidAbilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "windows", "effect"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "clickCost": { "type": "integer", "minimum": 0 },
          "creditCost": { "type": "integer", "minimum": 0 },
          "oncePerTurn": { "type": "boolean" },
          "cost": {
            "type": "object",
            "properties": {
              "clicks": { "type": "integer", "minimum": 0 },
              "credits": { "type": "integer", "minimum": 0 },
              "recurringCredits": { "type": "integer", "minimum": 0 },
              "virusCounters": { "type": "integer", "minimum": 0 },
              "trashSelf": { "type": "boolean" },
              "trashFromHq": { "type": "integer", "minimum": 0 },
              "trashFromGrip": { "type": "integer", "minimum": 0 }
            }
          },
          "windows": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "approach_paw",
                "approach_server_paw",
                "encounter_paw",
                "corp_action_paw",
                "runner_action_paw"
              ]
            }
          },
          "effect": { "type": "object" },
          "startsRun": { "$ref": "#/$defs/startsRunSpec" }
        }
      }
    },
    "runEvent": { "$ref": "#/$defs/startsRunSpec" },
    "installOnIce": { "type": "boolean" },
    "derezHostAtVirus": { "type": "integer", "minimum": 1 },
    "tagsIfAgendaStolenThisRun": { "type": "integer", "minimum": 0 },
    "approachServerTax": {
      "type": "object",
      "required": ["clicks", "credits"],
      "properties": {
        "clicks": { "type": "integer", "minimum": 0 },
        "credits": { "type": "integer", "minimum": 0 }
      }
    },
    "offerJackOutAfterSub": { "type": "integer", "minimum": 0 },
    "accessTrashFromGrip": {
      "type": "object",
      "required": ["gripCards"],
      "properties": {
        "gripCards": { "type": "integer", "minimum": 1 },
        "oncePerTurn": { "type": "boolean" }
      }
    },
    "mayInstallOnScoreOrSteal": { "type": "boolean" },
    "mayRezIceIgnoringCostsOnScoreOrSteal": { "type": "boolean" },
    "maySwapIceOnAgendaScoredOrStolen": { "type": "boolean" },
    "searchRdNonAgendaOnScoreFromServer": { "type": "boolean" },
    "onRez": { "type": "object" },
    "onPlay": { "type": "object" },
    "onScore": {
      "type": "object",
      "description": "Effect IR evaluated when Corp scores this agenda."
    },
    "onSteal": {
      "type": "object",
      "description": "Effect IR evaluated when Runner steals this agenda."
    },
    "onEncounter": {
      "type": "object",
      "description": "Effect IR evaluated when the Runner encounters this ice."
    },
    "onTurnBegin": {
      "type": "object",
      "description": "Effect IR evaluated when this card's controller's turn begins (rezzed/installed)."
    },
    "onInstall": {
      "type": "object",
      "description": "Effect IR evaluated when this card is installed."
    },
    "onSuccessfulRun": {
      "type": "object",
      "description": "Effect IR when the Runner makes a successful run while this card is installed."
    },
    "onAccess": {
      "type": "object",
      "description": "Effect IR when this card is accessed (ambushes)."
    },
    "onFirstTagThisTurn": {
      "type": "object",
      "description": "Effect IR the first time the Runner is tagged each turn (identities)."
    },
    "onAgendaScored": {
      "type": "object",
      "description": "Effect IR when Corp scores any agenda (identity continuous)."
    },
    "hostedCreditsOnInstall": {
      "type": "integer",
      "minimum": 0,
      "description": "Credits placed on this card when installed (e.g. Armitage)."
    },
    "strengthBonusProtectingRemote": {
      "type": "integer",
      "description": "Printed strength bonus while protecting a remote server."
    },
    "strengthBonusAtAdvancements": {
      "type": "object",
      "required": ["threshold", "bonus"],
      "properties": {
        "threshold": { "type": "integer", "minimum": 0 },
        "bonus": { "type": "integer" }
      }
    },
    "handSizeBonus": {
      "type": "integer",
      "description": "Modifier to controller max hand size while installed/scored."
    },
    "memoryCost": {
      "type": "integer",
      "minimum": 0,
      "description": "Memory units used by this program (default 1)."
    },
    "muBonus": {
      "type": "integer",
      "description": "Bonus to Runner memory limit while installed."
    },
    "strengthBonusPerIcebreaker": {
      "type": "integer",
      "description": "Strength bonus per installed icebreaker (Echelon)."
    },
    "installCostDiscountIfSuccessfulRunThisTurn": {
      "type": "integer",
      "minimum": 0
    },
    "firstProgramInstallDiscount": {
      "type": "integer",
      "minimum": 0
    },
    "drawOnHostedEmpty": {
      "type": "integer",
      "minimum": 0
    },
    "playRequiresTagged": { "type": "boolean" },
    "playRequiresSuccessfulRunLastTurn": { "type": "boolean" },
    "trashAfterBreakingThisRun": { "type": "boolean" },
    "creditsOnScoreOrSteal": { "type": "integer", "minimum": 0 },
    "creditsPerAccessOnCentralRunEnd": { "type": "boolean" },
    "onAccessTrashGain": {
      "type": "object",
      "properties": {
        "credits": { "type": "integer", "minimum": 0 },
        "draw": { "type": "integer", "minimum": 0 },
        "oncePerTurn": { "type": "boolean" }
      }
    },
    "prevention": {
      "type": "object",
      "properties": {
        "jackOutForRun": { "type": "boolean" }
      }
    },
    "unsupported": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit notes for clauses not implemented in the engine/IR yet."
    },
    "wave": { "type": "string" },
    "nrdbCode": {
      "type": "string",
      "description": "Optional NetrunnerDB code — metadata only, not behavior."
    }
  }
}
