[
  {
    "batch": "cr-examples-ch1",
    "case": "1.10.3c.ex2",
    "observations": [
      {
        "key": "::zone(The Future Perfect)",
        "expected": "runner-score",
        "engine": "hq"
      },
      {
        "key": "::runner.score",
        "expected": 3,
        "engine": 0
      }
    ],
    "verdict": "engine-wrong",
    "rule": "1.2.1",
    "area": "11",
    "note": "The Future Perfect only stops the steal when the bids differ. The engine does 1 net damage when they match (here it flatlines a Runner with an empty grip) and still lets the Runner steal when they differ"
  },
  {
    "batch": "cr-examples-ch1",
    "case": "1.12.2.ex1",
    "observations": [
      {
        "key": "first-use::zone(Vaporframe Fabricator)",
        "expected": "archives",
        "engine": "root:remote"
      },
      {
        "key": "restore::corp.credits",
        "expected": 2,
        "engine": 4
      },
      {
        "key": "::legal(second-use)",
        "expected": true,
        "engine": false
      },
      {
        "key": "second-use::installed(Ice Wall)",
        "expected": true,
        "engine": false
      },
      {
        "key": "second-use::corp.credits",
        "expected": 2,
        "engine": 4
      }
    ],
    "verdict": "engine-wrong",
    "rule": "8.5.6a",
    "note": "Installing an asset in a root must trash the asset already there. Vaporframe Fabricator leaves both in the root, so it is never trashed and Restore finds nothing",
    "area": "5"
  },
  {
    "batch": "cr-examples-ch1",
    "case": "1.13.6c.ex1#a",
    "observations": [
      {
        "key": "::legal(install)",
        "expected": false,
        "engine": true
      }
    ],
    "verdict": "engine-wrong",
    "rule": "1.13.6c",
    "note": "Egret installs only on a rezzed ice. The engine offers an unrezzed ice as its host",
    "area": "1"
  },
  {
    "batch": "cr-examples-ch1",
    "case": "1.13.9.ex1",
    "observations": [
      {
        "key": "leprechaun::runner.credits",
        "expected": 9,
        "engine": 8
      },
      {
        "key": "atman::runner.credits",
        "expected": 6,
        "engine": 5
      },
      {
        "key": "atman::runner.memoryUsed",
        "expected": 0,
        "engine": 1
      }
    ],
    "verdict": "engine-wrong",
    "rule": "1.13.9",
    "note": "Dhegdheer can host any other program, but the engine never offers it for Leprechaun (a daemon), so the discount and the memory are wrong; the credit left after Atman is 1 short for the same reason. (Atman's spend is a choice since RF-1b, CR 9.6.9c.)",
    "area": "1"
  },
  {
    "batch": "cr-examples-ch1",
    "case": "1.13.13.ex2",
    "observations": [
      {
        "key": "::zone(Next Big Thing)",
        "expected": "root:remote",
        "engine": "runner-score"
      },
      {
        "key": "::counters(Next Big Thing,agenda)",
        "expected": 0,
        "engine": 1
      },
      {
        "key": "::counters(Next Big Thing,advancement)",
        "expected": 1,
        "engine": 0
      },
      {
        "key": "::runner.score",
        "expected": 0,
        "engine": 3
      }
    ],
    "verdict": "engine-wrong",
    "rule": "8.5.2a",
    "note": "The Corp may install in a new remote server. IP Enforcement offers only existing remotes and stops with an error when there is none, after the tags are removed",
    "area": "5"
  },
  {
    "batch": "cr-examples-ch1",
    "case": "1.15.2c.ex1",
    "observations": [
      {
        "key": "::zone(Corroder)",
        "expected": "heap",
        "engine": "rig"
      },
      {
        "key": "::runner.heap",
        "expected": 1,
        "engine": 0
      }
    ],
    "verdict": "engine-wrong",
    "rule": "10.8.2",
    "note": "The Corp may spend credits on a trace. The trace on Burke Bugs resolves at once at strength 0 with no chance to spend, as most traces do",
    "area": "11"
  },
  {
    "batch": "cr-examples-ch1",
    "case": "1.16.2c.ex1",
    "observations": [
      {
        "key": "::legal(x0)",
        "expected": true,
        "engine": false
      }
    ],
    "verdict": "engine-wrong",
    "rule": "1.16.2c",
    "note": "X may be 0. Psychographics offers 1 to 3 only",
    "area": "11"
  },
  {
    "batch": "cr-examples-ch1",
    "case": "1.16.2f.ex1",
    "observations": [
      {
        "key": "::zone(Logjam)",
        "expected": "ice:HQ",
        "engine": "ice:remote"
      },
      {
        "key": "::counters(Logjam,advancement)",
        "expected": 1,
        "engine": 0
      },
      {
        "key": "::strength(Logjam)",
        "expected": 1,
        "engine": 0
      }
    ],
    "verdict": "engine-wrong",
    "rule": "8.5.2a",
    "note": "The Corp chooses where the ice found by Tucana is installed; the engine always uses the server Tucana is in. The ice is also marked rezzed without its when-rezzed ability, so Logjam gets no counter (CR 8.5.15, 8.1.2e)",
    "area": "5"
  },
  {
    "batch": "cr-examples-ch1",
    "case": "1.16.4d.ex1",
    "observations": [
      {
        "key": "blue-level::corp.clicks",
        "expected": 1,
        "engine": 0
      }
    ],
    "verdict": "engine-wrong",
    "rule": "5.2.5a",
    "note": "Takings of the same basic action are the same action. Jeeves Model Bioroids counts clicks inside one action only, so it never gives a click for three plays, draws or credits",
    "area": "11"
  },
  {
